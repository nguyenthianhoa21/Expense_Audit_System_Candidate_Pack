# ===== Copy file nay thanh .env roi dien gia tri thuc te =====
# KHONG BAO GIO commit file .env that vao git repository.

# --- OpenRouter (Layer 2: Model Chain Fallback) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Chuoi model theo thu tu uu tien, nhung bang dau phay
EXTRACTOR_MODEL_CHAIN=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# Ten hien thi tren OpenRouter leaderboard (khong bat buoc)
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=AI Expense Audit System
# json_object | json_schema | none
OPENROUTER_RESPONSE_FORMAT=json_object

# --- Layer 3: Retry & Timeout ---
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=1.5

# --- Database ---
# Postgres (khuyen nghi cho production):
# DATABASE_URL=postgresql+asyncpg://audit:audit@localhost:5432/expense_audit
# SQLite cho local dev:
DATABASE_URL=sqlite+aiosqlite:///./app.db

# --- Storage ---
STORAGE_PATH=./storage
MAX_UPLOAD_MB=20

# --- App ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
